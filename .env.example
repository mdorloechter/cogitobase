# --- Auth (REQUIRED) ---
# Generate one:  openssl rand -hex 32
# The server refuses to start when this is empty, shorter than 16 characters,
# non-ASCII, or a placeholder from this file or the docs — so an unedited copy
# cannot boot with a token that is public in every clone of this repo.
AUTH_TOKEN=

# --- Google Gemini Embeddings ---
GEMINI_API_KEY=your-gemini-api-key
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
LLM_MODEL=gemini-3.5-flash

# --- Git Sync (optional; the vault works without it) ---
# COMMENTED OUT ON PURPOSE. An unedited placeholder here points at a repo that is
# not yours: the clone fails, and the server logs it and carries on WITHOUT a git
# repo, so nothing is versioned and nothing is pushed. Left unset, the server says
# so loudly at startup ("running LOCAL-ONLY") — the honest state. Uncomment once
# your own remote exists to turn on the ADR-4 durability guarantee.
# Auth happens via an SSH DEPLOY KEY, never a token in the URL.
#   1. Generate a key:  ssh-keygen -t ed25519 -f ./ssh/id_ed25519 -N ""
#   2. Add ./ssh/id_ed25519.pub as a deploy key (write access) on the GitHub repo.
#   3. Seed known_hosts:  ssh-keyscan github.com > ./ssh/known_hosts
#   4. ./ssh is mounted read-only into the container (see docker-compose.yml).
# Use an ssh:// or git@ URL — NOT https with an embedded token. The server refuses
# to start on a URL that carries a credential: git echoes the URL in its own error
# output, so the token would end up in the logs in plaintext.
# GIT_REPO_URL=git@github.com:yourusername/personal-context.git
GIT_USER_NAME="MCP Server"
GIT_USER_EMAIL="mcp@yourdomain.com"
# Optional: override the in-container key path (defaults to /home/mcpuser/.ssh/id_ed25519).
# GIT_SSH_KEY=/home/mcpuser/.ssh/id_ed25519
# There is deliberately no GIT_SSH_COMMAND knob: the server builds that command from
# the mounted key, picking StrictHostKeyChecking=yes when you seeded known_hosts and
# accept-new when you did not. Setting it yourself in the environment suppresses that
# logic entirely — the key path and host-key policy then become yours to get right.

# --- Mem0 (single-tenant by design) ---
MEM0_USER_ID=admin
MEM0_MAX_FACT_CHARS=280
# mem0ai ships PostHog telemetry (install UUID + host/OS/CPU metadata, no note
# text). cogitobase defaults it OFF so the egress list in PRIVACY.md stays
# complete. Set True to opt back in.
# MEM0_TELEMETRY=False

# --- Augmentation tools (SSRF policy) ---
# Optional comma-separated domain allowlist. Empty = private/internal IP filter only.
# Applies to every external fetch, ingest_media's YouTube branch included — so add
# youtube.com,youtu.be if you set an allowlist and want transcripts.
AUGMENT_ALLOWED_DOMAINS=
FETCH_TIMEOUT=10
# Sent on every external fetch. The default is a complete browser header set: CDN bot
# filters answer a version-less UA with 403, which breaks arbitrary search-result URLs.
# Set this to identify your deployment instead (e.g. cogitobase/1.0 (+mailto:you@example.org)).
# FETCH_USER_AGENT=
# How much text ingest_media returns (CHARACTERS, ~4 per token). Sized for a context
# window: 50000 fits a long article whole and cuts a multi-hour transcript, which is
# then reported as cut. Raise it for a large-context model.
MAX_INGEST_CHARS=50000
# Largest upload_media file (BYTES, decoded). Base64 inflates the payload by 4/3 inside
# the JSON-RPC envelope, so MAX_REQUEST_BODY_BYTES is the effective ceiling: at its
# 4 MB default only ~3 MB of binary gets through and the request is rejected at the
# entrypoint. Raise both to actually upload 10 MB (roughly 14 MB of request body).
MAX_MEDIA_BYTES=10485760

# --- Ingress DoS protection (rate + body limits at the MCP entrypoint) ---
# Reject requests larger than this Content-Length (bytes). 0 = disabled. Also caps
# uploads — see MAX_MEDIA_BYTES above.
MAX_REQUEST_BODY_BYTES=4194304
# Per-client sliding-window rate limit, keyed by the (hashed) bearer token. It applies
# only to requests that already authenticated — rate-limit unauthenticated traffic at
# the reverse proxy, which is the only place the real client address is known.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Transport (Streamable HTTP) ---
# All four are optional; the defaults below are what the server uses unset.
# DNS-rebinding protection inside the transport is OFF while both allowlists are
# empty — setting EITHER of them turns it ON, so a host you forget to list is then
# refused. Left empty, the reverse proxy is the only host gate (ADR 8 / README §5).
# MCP_ALLOWED_HOSTS=brain.example.com
# MCP_ALLOWED_ORIGINS=https://brain.example.com
# Reply with one application/json body instead of an SSE stream (simpler for
# non-streaming clients; the default keeps the stream so progress can flow).
# MCP_JSON_RESPONSE=false
# Drop per-session state between requests, making each one self-contained.
# MCP_STATELESS=false

# --- Observability & Qdrant connection ---
# Logs go to stderr (stdout stays reserved for protocol). json is machine-readable;
# text is easier to read while developing.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Serve the Prometheus exposition at /metrics (behind the same auth as /mcp).
# METRICS_ENABLED=true
# Where to reach Qdrant. The default suits running the server directly on the host.
# Under the shipped compose file, setting QDRANT_HOST here has NO effect: the service
# definition pins it to the compose service name `qdrant`, which wins over .env.
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# --- Vault enforcement (Validating Server) ---
# Profile: strict (all structural rules hard) | balanced (schema hard, style warns) | lenient (only schema).
# Rollout tip: start with balanced, observe logs, then upgrade to strict.
VAULT_ENFORCEMENT=balanced
# Override individual rules: error | warn | off  (e.g., force preamble despite balanced)
# VAULT_RULE_PREAMBLE=error
# Linking to EXISTING notes: off | warn (suggest) | auto (insert)
VAULT_AUTOLINK=warn
# Dedup thresholds (Cosine). Soft = hint, Hard = reject (>1.0 = disabled).
VAULT_DEDUP_SOFT=0.92
VAULT_DEDUP_HARD=2.0
